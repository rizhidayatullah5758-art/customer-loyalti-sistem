{
  "expo": {
    "name": "Starpoint Garage",
    "slug": "starpoint-garage",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "starpointgarage",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Starpoint Garage menggunakan foto yang Anda pilih sebagai foto profil member.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "android": {
      "package": "com.rapscreative.starpointgarage",
      "versionCode": 1
    },
    "ios": {
      "bundleIdentifier": "com.rapscreative.starpointgarage"
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "appRole": "member"
    }
  }
}
